# Пути и имена этого сервера для install.sh. Скопировать в site.env (в git не попадает) и заполнить.
WEB=/opt/edge/edge-web                    # папка Caddy: compose.yml, caddy/, data/
SNI_CONF=/opt/edge/edge-router/nginx.conf # SNI-роутер (nginx stream) на 443
WEB_CONTAINER=edge-web                    # контейнер Caddy
SNI_CONTAINER=edge-router                 # контейнер SNI-роутера
PROXY_HOST=proxy.example.org              # прежний сайт сервера (отдельный блок в Caddyfile)
# не для install.sh: куда ходить по ssh и имя сайта Вахтёра
SSH_TARGET=root@SERVER_IP
VAHTER_HOST=vahter.example.org
