# Caddy перед Hermes: сайт для Вахтёра (Архитектура 9.0, 9.8). Кладётся вместо $WEB/caddy/Caddyfile (site.env)
# (прежний сайт сервера — {$PROXY_HOST}, оставлен как был). Порт 443 держит SNI-роутер (nginx stream), он отдаёт сюда
# соединения с именем {$VAHTER_HOST}; сертификат Caddy получает сам по TLS-ALPN через тот же порт (http-проверка выключена:
# 80 наружу закрыт). Ключ API Hermes телефон не знает: Caddy проверяет ключ телефона и подставляет свой.
# Ключи телефонов пишет навык vahter в $HERMES_HOME/vahter/devices.caddy (примонтировано в /etc/vahter).
{
	https_port 9443
}

https://{$PROXY_HOST}:9443 {
	bind 127.0.0.1
	tls /etc/letsencrypt/live/{$PROXY_HOST}/fullchain.pem /etc/letsencrypt/live/{$PROXY_HOST}/privkey.pem
	respond 403
}

https://{$VAHTER_HOST}:9443 {
	bind 127.0.0.1
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	request_body {
		max_size 25MB
	}
	log {
		output file /data/vahter-access.log {
			roll_size 10MB
			roll_keep 3
		}
		format filter {
			wrap json
			fields {
				# ключи телефонов в журнал не пишем
				request>headers>Authorization delete
			}
		}
	}

	# Ключи телефонов: по строке на устройство, файл ведёт навык vahter (перезагрузка — systemd path-юнит)
	import /etc/vahter/devices.caddy

	# Только то, что нужно приложению: модели (проверка), чат, задачи и ответы на подтверждения. Остальной API Hermes закрыт.
	@api {
		path /v1/models /v1/chat/completions /v1/runs /v1/runs/*
	}
	handle @api {
		handle @device {
			reverse_proxy 127.0.0.1:8642 {
				header_up Authorization "Bearer {$API_SERVER_KEY}"
				header_up -X-Forwarded-For
				flush_interval -1
				transport http {
					read_timeout 20m
					write_timeout 5m
					response_header_timeout 20m
				}
			}
		}
		respond 401
	}

	# Файлы от Hermes для телефона: только папка vahter-out дома Hermes, тем же ключом телефона, только чтение
	handle /vahter/files/* {
		handle @device {
			root * /srv
			file_server {
				hide .*
			}
		}
		respond 401
	}

	# Файлы от телефона для Hermes: API Hermes документы не принимает — телефон кладёт файл в vahter-in (vahter-upload.py,
	# только 127.0.0.1), в реплике — путь. Тот же ключ телефона; лимит тела — выше (25 МБ), приёмник режет на 20.
	handle /vahter/upload/* {
		handle @device {
			reverse_proxy 127.0.0.1:8650
		}
		respond 401
	}

	# Страница приглашения: ключ в #фрагменте, на сервер не уходит; открывает vahter://connect?url=…&token=…
	handle /vahter/connect {
		root * /etc/caddy
		rewrite * /connect.html
		file_server
	}

	handle {
		respond 404
	}
}
